<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import g_arm urdf file -->
    <xacro:include filename="$(find g_arm_description)/urdf/robot_electromagnet.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="$(find g_arm_moveit2)/config/g_arm.ros2_control.xacro" />

    <!-- Include ros2_control configuration -->
    <xacro:g_arm_ros2_control name="GArmTopicSystem" initial_positions_file="$(find g_arm_moveit2)/config/$(arg initial_positions_file)"/>

</robot>
