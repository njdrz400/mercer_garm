<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <xacro:macro name="g_arm_gazebo_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>
    
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      
      <!-- Joint 1 -->
      <joint name="joint1">
        <command_interface name="position">
          <param name="min">-1.5707</param>
          <param name="max">1.5707</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint1']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Joint 2 -->
      <joint name="joint2">
        <command_interface name="position">
          <param name="min">-1.5707</param>
          <param name="max">1.5707</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint2']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Joint 3 -->
      <joint name="joint3">
        <command_interface name="position">
          <param name="min">-1.5707</param>
          <param name="max">0.1</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['joint3']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Joint PWM (if needed for end effector) -->
      <joint name="jointPWM">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['jointPWM']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      
    </ros2_control>
    
    <!-- Gazebo plugin for ros2_control (Gazebo Garden) -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimSystemPlugin">
        <parameters>$(find g-arm_simulation)/config/gazebo_ros2_control.yaml</parameters>
      </plugin>
    </gazebo>
    
  </xacro:macro>
  
</robot>

