<?xml version="1.0"?>

<sdf version="1.10">

  <world name="tiny_wall_world">



    <!-- Ground plane -->

    <include>

      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground Plane</uri>

    </include>



    <!-- Light -->

    <include>

      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sun</uri>

    </include>



    <!-- 2 cm (0.02m) high, 3 cm (0.03m) long, 1 cm (0.01m) thick -->

    <model name="tiny_wall">

      <static>true</static>

      <pose>0.25 0.25 0 0 0 0</pose>



      <link name="wall_link">

        <visual name="wall_visual">

          <geometry>

            <box>

              <size>0.05 0.01 0.025</size>

            </box>

          </geometry>

          <material>

            <ambient>0.8 0.2 0.2 1</ambient>

          </material>

        </visual>



        <collision name="wall_collision">

          <geometry>

            <box>

              <size>0.03 0.01 0.02</size>

            </box>

          </geometry>

        </collision>

      </link>

    </model>



  </world>

</sdf>

