<?xml version="1.0"?>
<package format="3">
  <name>mercer_g_arm_topic_hw</name>
  <version>0.0.1</version>
  <description>ros2_control hardware shim publishing JointState commands to an existing driver.</description>

  <maintainer email="mizereks@mccc.edu">mizereks</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

