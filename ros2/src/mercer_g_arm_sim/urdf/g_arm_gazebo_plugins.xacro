<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- Macro to add Gazebo plugins to links -->
  <xacro:macro name="gazebo_plugins">
    
    <!-- Base link with inertial properties -->
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </gazebo>
    
    <!-- Motors link -->
    <gazebo reference="motors_link">
      <material>Gazebo/Blue</material>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </gazebo>
    
    <!-- Link 1 -->
    <gazebo reference="link1">
      <material>Gazebo/Blue</material>
      <inertial>
        <mass>0.8</mass>
        <inertia>
          <ixx>0.003</ixx>
          <iyy>0.003</iyy>
          <izz>0.003</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </gazebo>
    
    <!-- Link 2 -->
    <gazebo reference="link2">
      <material>Gazebo/Blue</material>
      <inertial>
        <mass>0.6</mass>
        <inertia>
          <ixx>0.002</ixx>
          <iyy>0.002</iyy>
          <izz>0.002</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </gazebo>
    
    <!-- End effector -->
    <gazebo reference="end_effector">
      <material>Gazebo/Blue</material>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </gazebo>
    
    <!-- Joint 1 with transmission -->
    <gazebo reference="joint1">
      <implicitSpringDamper>true</implicitSpringDamper>
      <stopCfm>0.01</stopCfm>
      <stopErp>0.1</stopErp>
    </gazebo>
    
    <!-- Joint 2 with transmission -->
    <gazebo reference="joint2">
      <implicitSpringDamper>true</implicitSpringDamper>
      <stopCfm>0.01</stopCfm>
      <stopErp>0.1</stopErp>
    </gazebo>
    
    <!-- Joint 3 with transmission -->
    <gazebo reference="joint3">
      <implicitSpringDamper>true</implicitSpringDamper>
      <stopCfm>0.01</stopCfm>
      <stopErp>0.1</stopErp>
    </gazebo>
    
  </xacro:macro>
  
</robot>

