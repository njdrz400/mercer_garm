# Goal fields (inputs)
geometry_msgs/PoseStamped target
float64 pos_tolerance_m
float64 ang_tolerance_rad
float64 timeout_sec
bool allow_orientation
string planner_frame
float64 speed_scale
float64 max_joint_vel
float64 max_joint_acc
bool electromagnet_on

---
# Result (final)
bool success
int32 error_code
string message
float64 final_pos_error_m
float64 final_ang_error_rad
float64[] final_joint_positions

---
# Feedback (streaming)
string state
float64 pos_error_m
float64 ang_error_rad
float64 progress
string detail
